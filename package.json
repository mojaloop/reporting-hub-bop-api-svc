{
  "name": "@mojaloop/reporting-hub-bop-api-svc",
  "version": "4.3.0",
  "description": "Reporting API",
  "scripts": {
    "prepare": "npm run generate",
    "test": "npm run test:unit",
    "test:unit": "npx jest --testMatch='**/test/unit/**/*.test.ts' --reporters=default",
    "test:int": "npx jest --testMatch='**/test/int/**/*.test.ts' --reporters=default --detectOpenHandles",
    "dev": "cross-env NODE_ENV=default tsnd --no-notify --respawn --transpile-only ./src",
    "generate": "ts-node --transpile-only ./src/schema",
    "build": "npm -s run clean && npm -s run generate && tsc && cp -r src/api dist/src/api",
    "clean": "rm -rf dist",
    "start": "cross-env NODE_ENV=default ts-node --transpile-only ./src",
    "start:dist": "TS_NODE_BASEURL=./dist node dist/src/index.js",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "audit:fix": "npm audit fix",
    "audit:check": "npx audit-ci --config ./audit-ci.jsonc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojaloop/reporting-hub-bop-api-svc.git"
  },
  "author": "Yevhen Kyriukha <yevhen.kyriukha@modusbox.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mojaloop/reporting-hub-bop-api-svc/issues"
  },
  "homepage": "https://github.com/mojaloop/reporting-hub-bop-api-svc#readme",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/convict": "6.1.1",
    "@types/cors": "2.8.13",
    "@types/jest": "27.4.0",
    "@types/node": "26.6.6",
    "audit-ci": "6.6.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "29.7.0",
    "prettier": "^3.9.10",
    "ts-jest": "29.3.2",
    "ts-node-dev": "1.1.8",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@apollo/server": "4.6.0",
    "@apollo/server-plugin-landing-page-graphql-playground": "4.0.0",
    "@mojaloop/authz": "^0.17.2",
    "@mojaloop/central-services-logger": "11.10.8-snapshot.0",
    "body-parser": "1.20.2",
    "connection-string": "4.3.6",
    "convict": "6.2.4",
    "cors": "2.8.5",
    "cross-env": "7.0.3",
    "dataloader": "2.0.0",
    "express": "4.18.2",
    "graphql": "16.6.0",
    "graphql-middleware": "6.1.33",
    "graphql-parse-resolve-info": "4.13.0",
    "graphql-scalars": "1.21.3",
    "graphql-shield": "7.6.5",
    "mongodb": "^4.3.0",
    "nexus": "1.3.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "@apollo/protobufjs": false
  }
}
